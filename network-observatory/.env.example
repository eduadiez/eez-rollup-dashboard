# Internal service names in the target Kurtosis Docker network.
EEZ_L1_RPC_URL=http://el-1-reth-lighthouse:8545
EEZ_L2_RPC_URL=http://eez-node:18688
EEZ_BEACON_URL=http://cl-1-lighthouse-reth:4000

# Public, non-secret deployment metadata.
EEZ_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
EEZ_ROLLUP_ID=1

# Bounded monitoring window and cache interval.
EEZ_RECENT_BLOCKS=12
EEZ_REFRESH_SECONDS=4
EEZ_REQUEST_TIMEOUT_SECONDS=4

# Optional public explorer roots. No links are rendered when unset.
EEZ_L1_EXPLORER_URL=
EEZ_L2_EXPLORER_URL=
EEZ_BLOBSCAN_URL=

# Public wallet JSON-RPC fronts. These are informational and never called by
# the read-only monitor server.
EEZ_L1_COMPOSER_RPC_URL=
EEZ_L2_COMPOSER_RPC_URL=

# Internal API used by the strict, server-side EEZ blob decoder.
EEZ_BLOBSCAN_API_URL=http://blobscan-api:3001

# Host-only direct access. HTTPS access is provided by the public gateway.
EEZ_DASHBOARD_BIND=127.0.0.1
EEZ_DASHBOARD_HOST_PORT=18080
EEZ_DOCKER_NETWORK=kt-eez-devnet
