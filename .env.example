# Docker image and published UI port
EEZ_UI_IMAGE=eez-rollup-ui:local
EEZ_UI_BIND=127.0.0.1
EEZ_UI_PORT=8080

# RPC targets as seen from inside the UI container. On Linux, the included
# Compose file maps host.docker.internal to the Docker host.
EEZ_UI_L1_RPC_UPSTREAM=http://host.docker.internal:19545
EEZ_UI_L2_RPC_UPSTREAM=http://host.docker.internal:19546
EEZ_UI_L1_FRONT_UPSTREAM=http://host.docker.internal:19547
EEZ_UI_L2_FRONT_UPSTREAM=http://host.docker.internal:19548

EEZ_UI_NETWORK_NAME=EEZ development network
EEZ_UI_ENCLAVE=standalone
EEZ_UI_PROTOCOL_COMMIT=development
EEZ_ROLLUP_ID=1

# Protocol contracts
EEZ_REGISTRY_ADDRESS=
EEZL2_ADDRESS=
EEZ_ECDSA_PROOF_SYSTEM_ADDRESS=
EEZ_ROLLUP_MANAGER_ADDRESS=
EEZ_L1_BRIDGE_SENDER=
EEZ_L2_BRIDGE_RECEIVER=

# Optional interactive demo signer and contracts. Never use a real funded key.
EEZ_UI_DEMO_ENABLED=false
EEZ_UI_DEMO_ACCOUNT_ADDRESS=
EEZ_UI_DEMO_PRIVATE_KEY=
EEZ_UI_DEMO_BRIDGE_ADDRESS=
EEZ_UI_DEMO_TOKEN_ADDRESS=
EEZ_UI_DEMO_POOL_ADDRESS=
EEZ_UI_DEMO_EXECUTOR_L1=
EEZ_UI_DEMO_EXECUTOR_L2=
EEZ_UI_DEMO_WRAPPED_TOKEN_L2=
EEZ_UI_DEMO_NFT_L2=
EEZ_UI_FAUCET_ADDRESS=

# Optional reverse-flow contracts
EEZ_UI_REVERSE_EXECUTOR_L2=
EEZ_UI_REVERSE_NFT_L1=
EEZ_UI_REVERSE_EXECUTOR_L1=

# Optional aggregator contracts
EEZ_UI_AGG_WETH_ADDRESS=
EEZ_UI_AGG_USDC_ADDRESS=
EEZ_UI_AGG_L1_AMM_ADDRESS=
EEZ_UI_AGG_AGGREGATOR_ADDRESS=
EEZ_UI_AGG_L2_EXECUTOR_ADDRESS=
EEZ_UI_AGG_L2_AMM_ADDRESS=
EEZ_UI_AGG_L2_EXECUTOR_PROXY_ADDRESS=
EEZ_UI_AGG_WRAPPED_WETH_L2=
EEZ_UI_AGG_WRAPPED_USDC_L2=

# Optional explorers
EEZ_UI_L1_EXPLORER_URL=
EEZ_UI_L2_EXPLORER_URL=
EEZ_UI_L2_EXPLORER_API_URL=

# Network monitor (served in the Monitor tab; shares the UI read RPCs).
# Configure both node WS(S) endpoints for immediate eth_subscribe/newHeads updates.
# URLs stay server-side. Leaving them blank uses HTTP polling instead.
# A failed subscription temporarily uses HTTP and reconnects automatically.
EEZ_L1_WS_URL=
EEZ_L2_WS_URL=
# Minimum time between detail collections; also the fallback head-poll interval.
# WebSocket head events are delivered immediately, independently of this value.
# Must be between 1 and EEZ_REFRESH_SECONDS (inclusive).
EEZ_LIVE_UPDATE_SECONDS=1

# Optional external Beacon REST API root, e.g. https://beacon.example.com
# Leave blank to disable sidecar checks.
EEZ_BEACON_URL=

# Optional public registry address; leave blank to disable commitment checks.

# Bounded monitoring window and cache interval.
EEZ_L1_RECENT_BLOCKS=20
EEZ_L2_RECENT_BLOCKS=100
# L1 cadence for sync-slot markers; Chiado uses 5000 ms. Blank disables markers.
EEZ_L1_BLOCK_TIME_MS=
EEZ_REFRESH_SECONDS=4
EEZ_REQUEST_TIMEOUT_SECONDS=4
# Warn when an L1 or L2 head is older than this many seconds (1..3600).
# This monitors block production, independently of settlement frequency.
EEZ_HEAD_DELAY_WARNING_SECONDS=30

# Settlement history has its own bounded log window, independent of recent
# block cards. Keep posts visible between infrequent settlements.
EEZ_SETTLEMENT_LOOKBACK_BLOCKS=512
EEZ_RECENT_SETTLEMENTS=12
# Native 18-decimal L1 receipt currency: ETH on Ethereum, XDAI on Gnosis/Chiado.
EEZ_L1_NATIVE_CURRENCY=ETH

# Optional: copy the actual node policy. Blank means configuration is unknown
# to the monitor; it never assumes the node has this policy or changes it.
# For the five-minute devnet use true / always / 150 / off / 2000 below.
EEZ_SETTLEMENT_POLICY_ENABLED=
EEZ_SETTLEMENT_PURE_L2_MODE=
EEZ_SETTLEMENT_PURE_L2_INTERVAL_MS=
EEZ_SETTLEMENT_MAX_UNSETTLED_L2_BLOCKS=
EEZ_SETTLEMENT_BLOB_FULLNESS_BPS=
EEZ_L2_BLOCK_TIME_MS=

# Optional public explorer roots. No links are rendered when unset.
EEZ_BLOBSCAN_URL=

# Public wallet JSON-RPC fronts. These are informational and never called by
# the read-only monitor server.
EEZ_L1_COMPOSER_RPC_URL=
EEZ_L2_COMPOSER_RPC_URL=

# Optional external Blobscan API root (separate from the explorer frontend),
# e.g. https://blobscan-api.example.com. Leave blank to disable blob decoding
# and historical lookup by blob versioned hash.
EEZ_BLOBSCAN_API_URL=
