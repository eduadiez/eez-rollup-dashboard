{
  "name": "eez-rollup-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:composer": "node tests/composer-discovery.test.mjs",
    "test:visualizer": "node tests/execution-debugger.test.mjs",
    "test:debug": "npm run build && node tests/quote-trace-debugger.cjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs src/lib/fees/*.test.mjs",
    "test:fees": "node --test src/lib/fees/*.test.mjs",
    "test:fees:browser": "node tests/cross-chain-fees.cjs && node tests/cross-chain-call-fees.cjs",
    "test:fees:config": "node tests/fee-config.cjs",
    "test:fees:kurtosis": "node tests/cross-chain-fees-kurtosis.cjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.21.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "1.63.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  }
}
